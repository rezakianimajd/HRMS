# HRMS Project Environment Variables
# =====================================

# Django Secret Key (change in production!)
SECRET_KEY=django-insecure-hrms-dev-key-change-in-production

# PostgreSQL Database
DB_NAME=hrms_db
DB_USER=hrms_user
DB_PASSWORD=hrms_password
DB_HOST=localhost
DB_PORT=5432

# Debug mode
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=*

# Base file storage path for employee files
BASE_FILE_STORAGE_PATH=/var/hr_data/

# CORS Allowed Origins (comma-separated, for production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Frontend URL
FRONTEND_URL=http://localhost:3000