# HRMS Project Environment Variables - EXAMPLE
# =============================================
# Copy this file to .env and fill in real values.
# Never commit the real .env file to version control.

# Django Secret Key (generate with: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=change-me-to-a-random-secret-key

# Encryption key for file storage engine
ENCRYPTION_KEY=change-me-to-a-random-encryption-key

# PostgreSQL Database
DB_NAME=hrms_db
DB_USER=hrms_user
DB_PASSWORD=change-me-strong-password
DB_HOST=localhost
DB_PORT=5432

# Debug mode (MUST be False in production)
DEBUG=False

# SSL/HTTPS (set True only when you have a TLS cert + real domain)
SSL_ENABLED=False

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,your-domain.com

# Base file storage path for employee files
BASE_FILE_STORAGE_PATH=/var/hr_data/

# CORS Allowed Origins (comma-separated, for production)
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Redis (cache / celery)
REDIS_CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Static & Media roots (production)
STATIC_ROOT=/var/www/hrms/static/
MEDIA_ROOT=/var/www/hrms/media/

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@your-domain.com
ADMIN_EMAIL=admin@your-domain.com

# Frontend URL
FRONTEND_URL=https://your-domain.com